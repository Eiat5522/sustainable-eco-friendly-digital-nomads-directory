{
  "explorer.excludeGitIgnore": false,
  "search.useParentIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "terminal.integrated.tabs.defaultColor": "terminal.ansiBlue",
  "terminal.integrated.cwd": "",
  "search.useIgnoreFiles": false,
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}",
    "!**/*.code-search",
    "!**/bower_components",
    "!**/node_modules",
    "!**/.git",
    "!**/vendor",
    "!**/*.instructions.md",
    "!**/*.chatmode.md",
    "!**/*parallel_workstreams.md"
  ],
  "markdown.validate.ignoredLinks": [
    "#runmode-chooser",
    "#runmode-tradeoff",
    "#quick-fix-chooser",
    "#virtual-folders",
    "#outputconfig-conflict",
    "#runmode-migration",
    "#auto-recovery-login-shell"
    ],
  "gitlens.graph.onlyFollowFirstParent": true,
  "git.openRepositoryInParentFolders": "never",
  "npm.packageManager": "pnpm",
  "jest.jestCommandLine": "pnpm exec jest",
  "jest.enable": true,
  "jest.debugMode": false,
  "jest.runMode": "on-demand",
  "jest.rootPath": "app-next-directory/src",
  "jest.coverageFormatter": "GutterFormatter",
  "files.watcherExclude": {
    "listings/**": true
  },
  "files.autoSave": "afterDelay",
  "editor.defaultFormatter": "esbenp.prettier-vscode"
}

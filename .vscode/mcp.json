    "task-master-ai": {
      "command": "npx",
      "args": ["-y", "--package=task-master-ai@0.24.0", "task-master-ai"],
      "env": {
        "GOOGLE_API_KEY": "${env:GOOGLE_API_KEY}",
        "OPENROUTER_API_KEY": "${env:OPENROUTER_API_KEY}",
        "TASK_MASTER_AI_VERSION": "0.24.0"
      },
      "type": "stdio"
    },
    "chroma": {
        "command": "uvx",
        "args": [
            "chroma-mcp-server",
            "--client-type=persistent",
            "--embedding-function=default"
        ],       
            "env": {
                "CHROMA_DATA_DIR": "D:/Eiat_Folder/AppData/Local/Cline/MCP/ChromaDB", // Replace with your actual path
                "CHROMA_LOG_DIR":  "${workspaceFolder}/.vscode",
                "LOG_LEVEL": "INFO",
                "MCP_LOG_LEVEL": "INFO"
            }
        }
    }
}
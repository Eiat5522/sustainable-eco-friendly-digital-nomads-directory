{
  "servers": {
    "chroma": {
        "command": "uvx",
        "args": [
            "chroma-mcp-server",
            "--client-type=persistent",
            "--embedding-function=default"
        ],       
            "env": {
                "CHROMA_DATA_DIR": "${workspaceFolder}/.chroma",
                "LOG_LEVEL": "INFO",
                "MCP_LOG_LEVEL": "INFO"
            }
        }
    }
}
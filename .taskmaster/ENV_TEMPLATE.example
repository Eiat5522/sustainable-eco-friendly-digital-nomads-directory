# TaskMaster Environment Template
# Copy this file to your HOME directory as ~/.taskmaster.env (Windows: $HOME\.taskmaster.env) and fill in values.
# NEVER commit the real .taskmaster.env with secrets.

GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
# Optional future providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Notes:
# - Use fine-grained GitHub PAT with least privileges.
# - Rotate keys if exposed.

# Environment variable template (validated against current codebase)
# Copy to `.env.local` (runtime) or `.env.test` (Playwright/Jest) and fill in as needed.

# --- Core application & URLs ---
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-secure-random
JWT_SECRET= # Optional fallback for newsletter token signing when NEXTAUTH_SECRET is unavailable
MONGODB_URI=mongodb://127.0.0.1:27017/sustainable_nomads_dev
REVALIDATION_TOKEN= # Required for ISR revalidation endpoints
PREVIEW_SECRET=dev-preview-secret
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
HOSTNAME=localhost

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN= # Primary API token for mutations
SANITY_API_READ_TOKEN= # Optional read-only token override
SANITY_TOKEN= # Legacy token fallback
SANITY_PREVIEW_SECRET=preview-secret
SANITY_FETCH_MODE=live # Supported values: live | mock | replay (see docs)
SANITY_HTTP_DEBUG=false

# --- Authentication & user management ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ADMIN_EMAILS=admin@example.com,owner@example.org
AUTH_REQUIRE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_AUTH_DISABLE_OAUTH=false
NEXT_PUBLIC_ALERT_EMAIL= # Optional alert recipient surfaced in performance budget warnings
BCRYPT_COST=12

# --- Email delivery (choose one provider) ---
CONTACT_EMAIL=admin@example.com
RESEND_API_KEY=
RESEND_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Legacy lower-case aliases are still read (contactEmail, smtpUser, smtpFrom, gmailUser, gmailAppPassword)
contactEmail=
smtpUser=
smtpFrom=
gmailUser=
gmailAppPassword=
nextAuthSecret=
nextPublicSanityProjectId=
revalidationToken=

# --- Analytics & monitoring ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
NEXT_PUBLIC_SLACK_WEBHOOK_URL= # For performance budget Slack notifications
NEXT_PUBLIC_ALERT_EMAIL=
ALERT_EMAIL_RECIPIENTS=alerts@example.com
ALERT_EMAIL_FROM=alerts@example.com
ALERT_SLACK_WEBHOOK=
ALERT_SLACK_CHANNEL=#performance-alerts
ALERT_WEBHOOK_URL=

# --- Rate limiting / caching ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Feature flags & build toggles ---
ENABLE_SOURCE_MAPS=false
ENABLE_TEST_PAGES=false
ANALYZE=false
ANALYZE_OPEN=false
ALLOW_INSECURE_HTTPS=false
NEXT_PUBLIC_E2E=0
E2E=0
EDGE_RUNTIME= # Set automatically when running on the Edge runtime
CI=false
SKIP_DB_CONNECT=false
MOCK_MONGODB=false
USE_REAL_MONGODB_FOR_TESTS=false
ALLOW_REAL_MONGO_IN_TESTS=false
ALLOW_MONGO_IN_TESTS=false
JEST_USE_REAL_MONGOOSE=false
JEST_RUN_INTEGRATION=false
JEST_UNIT_ONLY=false
JEST_CONSOLE_NO_FILTER=false
DEBUG_JEST_CONFIG=false
JEST_CONFIG_DEBUG=false
IS_REACT_ACT_ENVIRONMENT=true
JEST_WORKER_ID= # Automatically set by Jest
NEXT_RUNTIME=nodejs

# --- Playwright / E2E harness ---
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_DOTENV_PATH=.env.test
SKIP_PLAYWRIGHT_DOTENV=false
PLAYWRIGHT_TEST=
PLAYWRIGHT_WORKER_ID=
PW_TEST_HTML_REPORT=false
FORCE_PLAYWRIGHT_INSTALL=false
HEADLESS=true
JPW_DEBUG=false
API_BASE_URL=http://localhost:3000/api
BASE_URL=http://localhost:3000
E2E_BASE_URL=http://localhost:3000
E2E_USER_EMAIL=user@example.com
E2E_USER_PASSWORD=password123
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=adminpassword
E2E_VENUE_OWNER_EMAIL=venue@example.com
E2E_VENUE_OWNER_PASSWORD=venuepassword

# --- Test data & security scenarios (used by tests under tests/e2e/security) ---
TEST_HOME_URL=/
TEST_ADMIN_DASHBOARD_URL=/admin/dashboard
TEST_SIGNIN_URL=/auth/signin
TEST_SIGNUP_URL=/auth/signup
TEST_DASHBOARD_URL=/dashboard
TEST_CREATE_LISTING_URL=/dashboard/create-listing
TEST_CONTACT_URL=/contact
TEST_SEARCH_URL=/search
TEST_API_ADMIN_USERS_URL=/api/admin/users
TEST_API_LISTINGS_URL=/api/listings
TEST_API_USER_PROFILE_URL=/api/users/profile
TEST_API_CONTACT_URL=/api/contact
TEST_API_SEARCH_URL=/api/search
TEST_SEARCH_QUERY=test
TEST_CONTACT_NAME_PREFIX=User
TEST_CONTACT_MESSAGE_PREFIX=Message
TEST_CONTACT_EMAIL_PREFIX=test
TEST_CONTACT_EMAIL_DOMAIN=example.com
TEST_CONTACT_STANDARD_NAME=Test User
TEST_CONTACT_STANDARD_MESSAGE=Test message
TEST_CONTACT_RAPID_SUBMISSIONS=10
TEST_API_RATE_LIMIT_ITERATIONS=50
TEST_DIALOG_TIMEOUT=1000
TEST_RATE_LIMIT_PAUSE=100
TEST_CSP_VIOLATION_TIMEOUT=1000
TEST_WEAK_PASSWORDS=["password123","12345678"]
TEST_SQL_INJECTION_PAYLOADS=["' OR '1'='1"]
TEST_XSS_PAYLOADS=["<script>alert('xss')</script>"]
TEST_EMAIL_INJECTION_PAYLOADS=["To: victim@example.com"]
TEST_MALICIOUS_FILE_NAMES=["../../../etc/passwd"]
TEST_MALICIOUS_FILE_MIME=application/octet-stream
TEST_FILE_CONTENT=This is a test file
TEST_INLINE_SCRIPT_MESSAGE=console.log("This should be blocked")
TEST_LISTING_NAME=Test Listing
TEST_LISTING_DESCRIPTION=Test Description
TEST_SESSION_TOKEN_KEY=next-auth.session-token
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=password123
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=admin123
TEST_VENUE_OWNER_EMAIL=venue@example.com
TEST_VENUE_OWNER_PASSWORD=venue123
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/sustainable_nomads_test

# --- Observability & misc platform values ---
VERCEL= # Provided by Vercel runtime (do not set locally)
VERCEL_URL= # Provided by Vercel runtime (used for image host allowlist)
npm_package_version= # Automatically injected by npm/pnpm scripts


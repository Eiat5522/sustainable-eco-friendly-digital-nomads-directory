{
  "output": {
    "filePath": "listing-repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "headerText": "",
    "instructionFilePath": "",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 50,
    "showLineNumbers": false,
    "copyToClipboard": true,
    "includeEmptyDirectories": false,
    "compress": false
  },
  "include": [
    "app-next-directory"
    
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": []
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  },
  "cwd": "."
}
{
  "compilerOptions": {
    "target": "ES6",
    "module": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": false,
    "noEmit": true,
    "composite": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "noErrorTruncation": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@app-next/types/*": ["app-next-directory/src/types/*"],
      "@app-next/types/listings": ["app-next-directory/src/types/listings.ts"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "declaration": true,
    "stripInternal": true,
    "declarationDir": "dist/types",
    "noEmit": false
  },
  "include": [
    "src/**/*",
    "app-next-directory/sanity.types.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/**",
    "playwright-report/**",
    "coverage/**"
  ],
  "references": [
    { "path": "./sanity"}
  ]
}

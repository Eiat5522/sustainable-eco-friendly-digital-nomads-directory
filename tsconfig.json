{
  "compilerOptions": {
    "target": "ES2017",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "checkJs": false,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "noErrorTruncation": true,
    "jsx": "preserve",
    "isolatedModules": true,
    "paths": {
      "@/*": ["./app-next-directory/src/*"],
      "@sanity/*": ["./sanity/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true
  },
  "include": [
    "app-next-directory/src/**/*",
    "app-next-directory/app/**/*",
    "sanity/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "*/node_modules",
    "**/tests/**",
    "**/test/**",
    "**/*.test.*",
    "**/playwright-report/**",
    "**/coverage/**",
    "**/.next/**",
    "**/dist/**"
  ]
}

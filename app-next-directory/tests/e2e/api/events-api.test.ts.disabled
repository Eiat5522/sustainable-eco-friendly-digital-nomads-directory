import request from 'supertest';

const baseURL = (process.env.BASE_URL || 'http://localhost:3000').replace(/\/+$/, '');

describe('/api/events (Jest + supertest)', () => {
  jest.setTimeout(60000);
  const req = () =>
    request(baseURL).timeout({ deadline: 30000, response: 15000 });

  it('GET /api/events returns 200 and a data array', async () => {
const res = await req().get('/api/events');

    expect(res.status).toBe(200);
    expect(res.headers['content-type']).toMatch(/application\/json/i);
    expect(res.body).toBeDefined();
    expect(typeof res.body.success).toBe('boolean');
    expect(Array.isArray(res.body.data)).toBe(true);
  });

  it('GET /api/events handles empty result set', async () => {
    const res = await req()
      .get('/api/events?q=__no_such_event__');

    expect(res.status).toBe(200);
    expect(Array.isArray(res.body.data)).toBe(true);
    expect(res.body.data.length).toBe(0);
  });
});

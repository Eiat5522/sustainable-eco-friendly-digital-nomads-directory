// Disabled: `/listings` index route is not implemented; filter UX is covered by Jest tests for `SearchFiltersForm`.
import { expect, test } from '@playwright/test';

test.describe('Listings filters', () => {
  test('applies filters and updates results (desktop)', async ({ page }) => {
    // 1. Visit `/listings`.
    await page.goto('/listings');

    // 2. Assert page loads and listing grid visible.
    const grid = page.getByTestId('listing-grid');
    await expect(grid).toBeVisible();

    // 3. Open city filter and select Testville
    // TODO: ensure the city filter has data-testid `filter-city` in the app
    await page.getByTestId('filter-city').click();
    await page.getByRole('option', { name: 'Testville' }).click();

    // 4. Assert listing results update to show only Testville results
    await expect(page.getByTestId('listing-card')).toHaveCount(2);

    // 5. Open category filter and select Coworking
    await page.getByTestId('filter-category').click();
    await page.getByRole('option', { name: 'Coworking' }).click();
    // Combined filters should narrow results
    await expect(page.getByTestId('listing-card')).toHaveCount(1);

    // 7. Toggle eco-tag filter
    await page.getByTestId('filter-eco-solar-powered').click();
    await expect(page.getByTestId('listing-card')).toContainText('solar');

    // 9. Test search
    await page.getByTestId('search-input').fill('Test Listing 1');
    await page.getByTestId('search-input').press('Enter');
    await expect(page.getByTestId('listing-card')).toHaveCount(1);
  });

  test.use({ viewport: { width: 375, height: 812 } });
  test('mobile filter drawer works and closes after apply (mobile)', async ({ page }) => {
    // Navigate mobile
    await page.goto('/listings');

    // Open mobile filter drawer
    await page.getByTestId('mobile-filter-button').click();
    await expect(page.getByTestId('mobile-filter-drawer')).toBeVisible();

    // Apply a sample filter and assert drawer closes
    await page.getByTestId('mobile-filter-city').click();
    await page.getByRole('option', { name: 'Testville' }).click();
    await page.getByTestId('mobile-filter-apply').click();
    await expect(page.getByTestId('mobile-filter-drawer')).toBeHidden();
  });
});

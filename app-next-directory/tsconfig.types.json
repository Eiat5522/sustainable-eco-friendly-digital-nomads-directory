{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/types",
    "stripInternal": true,
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "global.d.ts",
    "next-env.d.ts",
    "sanity.config.ts"
  ],
  "exclude": [
    "app/**",
    "src/app/**",
    "__mocks__/**",
    ".next",
    "dist/**",
    "tests",
    "**/__tests__",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*"
  ]
}

{
  "name": "app-next-directory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "bash ../scripts/clean-build-artifacts.sh && next dev",
    "build": "pnpm run build:types && next build",
    "build:types": "tsc -p tsconfig.types.json",
    "check-types": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "start": "next start",
    "preview": "next start",
    "clean": "bash ../scripts/clean-build-artifacts.sh",
    "validate:env": "node scripts/validate-env.js",
    "msw:init": "msw init public --save",
    "postinstall": "node scripts/postinstall-playwright.cjs && node scripts/postinstall-msw.cjs",
    "install:playwright": "pnpm exec playwright install --with-deps",
    "install:playwright:ci": "pnpm exec playwright install chromium --with-deps",
    "test:playwright": "pnpm exec playwright test",
    "exec:jest": "jest",
    "test": "pnpm test:unit",
    "test:unit": "cross-env JEST_UNIT_ONLY=1 jest --config=jest.config.cjs --runInBand --passWithNoTests",
    "test:unit:fast": "cross-env JEST_UNIT_ONLY=1 jest --config=jest.config.cjs --passWithNoTests --maxWorkers=50%",
    "test:unit:debug-leaks": "cross-env JEST_UNIT_ONLY=1 jest --config=jest.config.cjs --runInBand --passWithNoTests --detectOpenHandles --logHeapUsage --silent --noStackTrace",
    "test:unit:coverage": "cross-env JEST_UNIT_ONLY=1 jest --config=jest.config.cjs --passWithNoTests --coverage",
    "test:unit:export": "cross-env JEST_UNIT_ONLY=1 jest --config=jest.config.cjs --runInBand --passWithNoTests --coverage --json --outputFile=tmp/unit_test_output.json",
    "test:unit:export:tee": "cross-env JEST_UNIT_ONLY=1 jest --config=jest.config.cjs --runInBand --passWithNoTests --coverage 2>&1 | tee tmp/unit_test_output.txt",
    "test:integration": "cross-env JEST_USE_REAL_MONGOOSE=1 JEST_RUN_INTEGRATION=1 jest --config=jest.integration.config.cjs --runInBand --passWithNoTests",
    "test:e2e": "pnpm test:e2e:ci",
    "test:e2e:ci": "cross-env NEXT_PUBLIC_SANITY_PROJECT_ID='test-project-id' NEXT_PUBLIC_SANITY_DATASET='test' NEXTAUTH_SECRET='e2e-test-secret-for-testing-only-not-production' E2E='1' NEXT_PUBLIC_E2E='1' ENABLE_TEST_PAGES='true' USE_REAL_MONGODB_FOR_E2E='1' MONGODB_URI='mongodb://127.0.0.1:27017/e2e_test' NEXTAUTH_URL='http://localhost:3000' NEXT_PUBLIC_FRONTEND_URL='http://localhost:3000' RESEND_API_TOKEN='' UPSTASH_REDIS_REST_URL='' UPSTASH_REDIS_REST_TOKEN='' SANITY_API_TOKEN='e2e-sanity-api-token-for-testing-only' DISABLE_MONGODB_DURING_BUILD='true' playwright test --config=playwright.config.ts",
    "test:e2e:list": "playwright test --list --config=playwright.config.ts",
    "test:e2e:legacy": "jest --config=jest.e2e.config.cjs --runInBand --detectOpenHandles --passWithNoTests --",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "test:coverage": "jest --config=jest.config.cjs --coverage",
    "test:ci": "pnpm lint && pnpm tsc --noEmit && pnpm test:unit",
    "test:full": "pnpm test:ci && pnpm test:integration && pnpm test:e2e",
    "format": "cd .. && biome format --write .",
    "format:check": "cd .. && biome format .",
    "lint:biome": "cd .. && biome lint .",
    "lint:biome:fix": "cd .. && biome lint --write .",
    "lint:eslint": "eslint .",
    "lint:eslint:strict": "eslint --max-warnings=none .",
    "lint": "pnpm lint:biome && pnpm lint:eslint",
    "e2e:setup": "node tests/setup-e2e-db.mjs",
    "e2e:clean": "node tests/setup-e2e-db.mjs",
    "test:e2e:isolated": "cd .. && bash run-e2e-docker.sh",
    "test:e2e:debug": "PWDEBUG=1 playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=playwright.config.ts"
  },

{
  "name": "app-next-directory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "bash ../scripts/clean-build-artifacts.sh && next dev",
    "build": "pnpm run build:types && next build",
    "build:types": "tsc -p tsconfig.types.json",
    "check-types": "tsc --noEmit",
    "start": "next start",
    "preview": "next start",
    "clean": "bash ../scripts/clean-build-artifacts.sh",
    "validate:env": "node scripts/validate-env.js",
    "msw:init": "msw init public --save",
    "postinstall": "node scripts/postinstall-playwright.cjs && node scripts/postinstall-msw.cjs",
    "install:playwright": "pnpm exec playwright install --with-deps",
    "install:playwright:ci": "pnpm exec playwright install chromium --with-deps",
    "test:playwright": "pnpm exec playwright test",
    "exec:jest": "jest",
    "test": "pnpm test:unit",
    "test:unit": "cross-env JEST_UNIT_ONLY=1 jest --config=jest.config.cjs --runInBand --passWithNoTests",
    "test:unit:coverage": "cross-env JEST_UNIT_ONLY=1 jest --config=jest.config.cjs --passWithNoTests --coverage",
    "test:integration": "pnpm test:integration:node && pnpm test:integration:react",
    "test:integration:node": "cross-env JEST_USE_REAL_MONGOOSE=1 JEST_RUN_INTEGRATION=1 jest --config=jest.integration.config.cjs --runInBand --passWithNoTests",
    "test:integration:react": "cross-env JEST_USE_REAL_MONGOOSE=1 JEST_RUN_INTEGRATION=1 jest --config=jest.react-integration.config.cjs --runInBand --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:legacy": "jest --config=jest.e2e.config.cjs --runInBand --detectOpenHandles --passWithNoTests --",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "test:coverage": "jest --config=jest.config.cjs --coverage",
    "test:ci": "jest --config=jest.config.cjs --runInBand",
    "lint": "eslint .",
    "lint:strict": "next lint --max-warning=0",
    "test:visual": "pnpm exec percy exec -- pnpm exec playwright test tests/visual",
    "test:bs": "pnpm exec playwright test --config=playwright.browserstack.config.ts"
  },

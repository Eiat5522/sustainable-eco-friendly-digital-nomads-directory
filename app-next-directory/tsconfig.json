{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "checkJs": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "baseUrl": ".",
    "declaration": false,
    "noEmit": true
  },
  "include": [
    "*.cjs",
    "*.mjs",
    "./*.js",
    "app/**/*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "dist/types/**/*.d.ts",
    "global.d.ts",
    "jest.polyfills.ts",
    "jest.setup.ts",
    "next-env.d.ts",
    "sanity.config.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "dist/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

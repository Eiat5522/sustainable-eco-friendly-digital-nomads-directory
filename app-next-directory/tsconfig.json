{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": ".",
    "declaration": false,
    "noEmit": true
  },
  "include": [
    "*.cjs",
    "*.mjs",
    "./*.js",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.d.ts",
    "global.d.ts",
    "jest.polyfills.ts",
    "jest.setup.ts",
    "next-env.d.ts",
    "sanity.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

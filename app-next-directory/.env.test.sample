# --------------------------------------------------------------------------------------------------
# Playwright & Security Test Environment Sample
# Copy this file to `.env.test` before running Playwright smoke or security suites.
# --------------------------------------------------------------------------------------------------

# --- Required Test Credentials ---
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=adminpass123
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=adminpass123
TEST_VENUE_OWNER_EMAIL=venue@example.com
TEST_VENUE_OWNER_PASSWORD=adminpass123

# --- Optional Test Identifiers ---
TEST_GENERIC_EMAIL=tester@example.com
TEST_SESSION_TOKEN_KEY=authjs.session-token
TEST_CONTACT_EMAIL_DOMAIN=example.com

# --- Sanity / API Defaults (override in CI if needed) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=test-project
NEXT_PUBLIC_SANITY_DATASET=test-dataset
# SANITY_STUDIO_DATASET=test-dataset  # Uncomment if Studio should target this dataset during tests

# --- Local Test Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/sustainable_nomads_test

# --- Upstash Redis (Optional for tests - will use mocks if not provided) ---
# UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# --- Email Configuration for Tests ---
# Email is mocked in tests but can be configured for integration testing
CONTACT_EMAIL=test-admin@example.com
SMTP_FROM=noreply@example.com
# For testing with real email services (optional):
# RESEND_API_KEY=test-resend-api-key
# GMAIL_USER=test@gmail.com
# GMAIL_APP_PASSWORD=test-app-password

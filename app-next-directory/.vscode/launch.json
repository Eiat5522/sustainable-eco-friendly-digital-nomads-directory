{
    "configurations": [
        
        {
            "type": "msedge",
            "name": "Launch Microsoft Edge",
            "request": "launch",
            "runtimeArgs": [
                "--remote-debugging-port=9222"
            ],
            "url": "${env:DEV_SERVER_URL}",
            "webRoot": "${workspaceFolder}",
            "userDataDir": true,
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "msedge",
            "name": "Launch Microsoft Edge in headless mode",
            "request": "launch",
            "runtimeArgs": [
                "--headless",
                "--remote-debugging-port=9222"
            ],
                "url": "${env:DEV_SERVER_URL}",
            "webRoot": "${workspaceFolder}", 
            "userDataDir": true,
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "chrome",
            "name": "Chrome: Launch (JS Debugger)",
            "request": "launch",
            "url": "${config:devServer.url}",
            "webRoot": "${workspaceFolder}",
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "node",
            "name": "vscode-jest-tests.v2.app-next-directory",
            "request": "launch",
            "args": [
                "test",
                "--",
                "--runInBand",
                "--watchAll=false",
                "--testNamePattern",
                "${jest.testNamePattern}",
                "--runTestsByPath",
                "${jest.testFile}"
            ],
            "cwd": "${workspaceFolder}/app-next-directory",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "runtimeExecutable": "pnpm"
        }
    ]
}
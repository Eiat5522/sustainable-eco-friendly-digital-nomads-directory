{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*", "app/*"],
      "@mocks/*": ["__mocks__/*"],
      "@sanity/sanity.types": ["sanity.types"],
      "@tests/*": ["tests/*"]
    }
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**/*.ts",
    "**/__tests__/**/*.tsx"
  ]
}

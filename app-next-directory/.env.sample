# --------------------------------------------------------------------------------------------------
# Development Environment Sample
# Copy this file to `.env.local` (or `.env.development`) when running the Next.js app locally.
# --------------------------------------------------------------------------------------------------

# --- Core Services (Critical) ---
MONGODB_URI=mongodb://127.0.0.1:27017/sustainable_nomads_dev
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_STUDIO_DATASET=production  # Uncomment to point the Studio at a specific dataset
SANITY_API_TOKEN=your-sanity-token
SANITY_API_VERSION=2024-05-16

# --- NextAuth / Authentication ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand

# --- Optional Feature Flags ---
NEXT_TELEMETRY_DISABLED=1
PLAYWRIGHT_BASE_URL=http://localhost:3000

# --------------------------------------------------------------------------------------------------
# Development Environment Sample
# Copy this file to `.env.local` (or `.env.development`) when running the Next.js app locally.
# --------------------------------------------------------------------------------------------------

# --- Core Services (Critical) ---
MONGODB_URI=mongodb://127.0.0.1:27017/sustainable_nomads_dev
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_STUDIO_DATASET=production  # Uncomment to point the Studio at a specific dataset
SANITY_API_TOKEN=your-sanity-token
SANITY_API_VERSION=2024-05-16

# --- NextAuth / Authentication ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Upstash Redis (Required for rate limiting) ---
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# --- ISR Revalidation Token (Required for cache revalidation in production) ---
# Used to secure the /api/revalidate and /api/revalidate-all endpoints
# Generate a secure random token (e.g., using `openssl rand -base64 32`)
REVALIDATION_TOKEN=your-secure-revalidation-token

# --- Email Configuration (Required for Contact Form & Notifications) ---
# Option 1: Resend (Recommended for production)
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM=noreply@yourdomain.com

# Option 2: SMTP (Generic SMTP server)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com

# Option 3: Gmail (For development only - requires app password)
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password

# Contact form recipient email
CONTACT_EMAIL=admin@yourdomain.com

# --- Optional Feature Flags ---
NEXT_TELEMETRY_DISABLED=1
PLAYWRIGHT_BASE_URL=http://localhost:3000

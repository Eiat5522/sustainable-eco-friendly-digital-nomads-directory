# Local override for Playwright (no E2E/NEXT_PUBLIC_E2E to allow reuseExistingServer
E2E_USER_EMAIL=e2e-test@example.com
E2E_USER_PASSWORD=TestSecurePass123!
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=TestSecurePass123!
E2E_VENUE_OWNER_EMAIL=venue@example.com
E2E_VENUE_OWNER_PASSWORD=TestSecurePass123!
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=password123
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=admin123
TEST_VENUE_OWNER_EMAIL=venue@example.com
TEST_VENUE_OWNER_PASSWORD=venue123
TEST_GENERIC_EMAIL=tester@example.com
TEST_SESSION_TOKEN_KEY=next-auth.session-token
TEST_CONTACT_EMAIL_DOMAIN=example.com
NEXT_PUBLIC_SANITY_PROJECT_ID=test-project-id
NEXT_PUBLIC_SANITY_DATASET=test
MONGODB_URI=mongodb://127.0.0.1:27017/e2e_test
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=e2e-test-secret-for-testing-only-not-production
CONTACT_EMAIL=test-admin@example.com
SMTP_FROM=noreply@example.com
NODE_ENV=test
NEXT_TELEMETRY_DISABLED=1

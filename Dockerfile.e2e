# Dockerfile for E2E Testing
FROM node:20-alpine

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install Playwright dependencies
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-dejavu

# Set Playwright to use system chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
# Ensure production build mode inside the image
ENV NODE_ENV=production

# Create app directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app-next-directory/package.json ./app-next-directory/
COPY app-next-directory/scripts ./app-next-directory/scripts

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy application code
COPY . .

# Build the application
WORKDIR /app/app-next-directory
RUN mkdir -p /app/app-next-directory/test-results /app/app-next-directory/playwright-report \
    && pnpm build

# Expose port for the application
EXPOSE 3000

# Default command
CMD ["pnpm", "test:e2e"]

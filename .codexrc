{
  "sandbox": {
    "network": "limited",
    "allowedDomains": [
      "registry.npmjs.org",
      "github.com",
      "raw.githubusercontent.com",
      "mongo"
    ],
    "allowedMethods": ["GET", "HEAD"],
    "workspaceWrite": true
  },
  "security": {
    "promptInjectionProtection": true,
    "secretsScanning": true
  }
}


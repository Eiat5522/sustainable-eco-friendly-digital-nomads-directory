{
  "name": "mcp-apps-server",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Phase 1 MCP Apps server workspace for workday planner parity",
  "author": "",
  "license": "MIT",
  "keywords": [
    "mcp",
    "server",
    "starter",
    "tools",
    "resources",
    "prompts",
    "uiresource",
    "ui",
    "react",
    "widgets",
    "mcp-ui",
    "apps-sdk"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "mcp-use build",
    "check-types": "tsc --noEmit",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "test:smoke": "tsx scripts/mcp-smoke-test.ts",
    "test:validate": "tsx scripts/validate-mcp-apps.ts",
    "type-check": "tsc --noEmit",
    "deploy": "mcp-use deploy",
    "postinstall": "mcp-use generate-types || exit 0"
  },
  "dependencies": {
    "@sanity/client": "^7.12.1",
    "@openai/apps-sdk-ui": "^0.2.1",
    "dotenv": "^16.6.1",
    "mcp-use": "latest",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "tailwindcss": "^4.2.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

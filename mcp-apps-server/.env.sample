# --------------------------------------------------------------------------------------------------
# MCP Apps Server Environment Sample
# Copy this file to `.env.local` or `.env` inside `mcp-apps-server/` before running the standalone
# MCP server locally.
# --------------------------------------------------------------------------------------------------

# --- MCP Server Runtime ---
PORT=3337
MCP_URL=http://127.0.0.1:3337
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# --- Sanity / Directory Data ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=your-sanity-read-token
# SANITY_API_TOKEN=your-sanity-token
# SANITY_TOKEN=your-sanity-token

# --- Optional Build / Debug Flags ---
# DISABLE_SANITY_DURING_BUILD=true

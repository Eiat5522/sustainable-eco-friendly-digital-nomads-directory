{
  "name": "sustainable-eco-friendly-digital-nomads-directory-root",
  "packageManager": "pnpm@10.15.0",
  "workspaces": [
    "app-next-directory",
    "sanity"
  ],
  "version": "0.1.3",
  "private": true,
  "description": "Root package for the Sustainable Eco-Friendly Digital Nomads Directory project",
  "scripts": {
    "clean": "bash ./scripts/clean-build-artifacts.sh",
    "exec:jest": "pnpm --filter app-next-directory exec:jest",
    "test": "pnpm --filter app-next-directory test",
    "test:unit": "pnpm --filter app-next-directory test:unit",
    "test:unit:fast": "pnpm --filter app-next-directory test:unit:fast",
    "test:unit:debug-leaks": "pnpm --filter app-next-directory test:unit:debug-leaks",
    "test:unit:export": "pnpm --filter app-next-directory test:unit:export",
    "test:unit:export:tee": "pnpm --filter app-next-directory test:unit:export:tee",
    "test:integration": "pnpm --filter app-next-directory test:integration",
    "test:e2e": "pnpm --filter app-next-directory test:e2e",
    "test:e2e:legacy": "pnpm --filter app-next-directory test:e2e:legacy",
    "e2e:setup": "pnpm --filter app-next-directory e2e:setup",
    "e2e:clean": "pnpm --filter app-next-directory e2e:clean",
    "test:e2e:isolated": "pnpm --filter app-next-directory e2e:setup && pnpm --filter app-next-directory test:e2e",
    "test:e2e:debug": "pnpm --filter app-next-directory test:e2e:debug",
    "test:e2e:ui": "pnpm --filter app-next-directory test:e2e:ui",
    "dev:next": "pnpm --filter app-next-directory dev",
    "dev:next:debug": "pnpm --filter app-next-directory dev --inspect --",
    "dev:clean": "bash ./scripts/clean-build-artifacts.sh && pnpm dev:next",
    "dev:sanity": "pnpm --filter sanity dev",
    "dev": "pnpm dev:next",
    "dev:debug": "pnpm dev:next --inspect",
    "build:next": "NEXT_BUILD_MODE=true DISABLE_UPSTASH_DURING_BUILD=1 pnpm --filter app-next-directory build",
    "build:next:mock": "NEXT_PUBLIC_MOCK_SANITY_DATA=true NEXT_BUILD_MODE=true DISABLE_UPSTASH_DURING_BUILD=1 pnpm --filter app-next-directory build",
    "build:sanity": "pnpm --filter sanity build",
    "build": "bash -lc 'set -o pipefail; pnpm build:next \"$@\" | grep -v \"Skipping validation of types\" | grep -v \"Skipping linting\" && pnpm build:sanity | grep -v \"Skipping validation of types\" | grep -v \"Skipping linting\"'",
    "start:next": "pnpm --filter app-next-directory start",
    "start:sanity": "pnpm --filter sanity start",
    "start": "pnpm start:next",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:biome": "biome lint .",
    "lint:biome:fix": "biome lint --write .",
    "lint:eslint": "pnpm --filter app-next-directory lint:eslint",
    "lint:eslint:strict": "pnpm --filter app-next-directory lint:eslint:strict",
    "lint": "biome lint . && pnpm lint:eslint",
    "test:watch": "pnpm --filter app-next-directory test:watch",
    "test:coverage": "pnpm --filter app-next-directory test:coverage",
    "test:ci": "biome lint . && pnpm lint:eslint && tsc --noEmit && pnpm --filter app-next-directory test:unit",
    "test:full": "pnpm --filter app-next-directory test:full",
    "check-types": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "types:postprocess": "node sanity-types-postprocess.js",
    "update-types": "cd sanity && pnpm update-types",
    "typegen": "cd sanity && pnpm --filter sanity update-types && pnpm run types:postprocess",
    "validate:specs": "node ./scripts/spec-validator.js"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@sanity/client": "^7.12.1",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "16.5.0",
    "react-hook-form": "^7.66.0",
    "resend": "^4.8.0",
    "vscode-variables": "^1.0.1"
  },
  "jest": "./app-next-directory/jest.config.cjs",
  "pnpm": {
    "overrides": {
      "jest": "29.3.1",
      "jest-circus": "29.3.1",
      "jest-runner": "29.3.1",
      "jest-environment-node": "29.3.1",
      "prismjs": "^1.30.0",
      "nodemailer": "^7.0.10",
      "@types/react": "19.2.7"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "eslint"
      ],
      "allowedVersions": {
        "styled-components": "6.1.19"
      }
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js",
      "mongodb-memory-server",
      "msw"
    ],
    "ignoredBuiltDependencies": [
      "@percy/core",
      "bcrypt",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@auth/mongodb-adapter": "^3.11.1",
    "@biomejs/biome": "^2.3.7",
    "@next/eslint-plugin-next": "15.5.0",
    "@playwright/test": "^1.55.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^30.0.0",
    "ajv": "^8.12.0",
    "cross-fetch": "^4.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "js-yaml": "^4.1.1",
    "ts-jest": "^29.4.1",
    "typescript": "5.9.3"
  }
}

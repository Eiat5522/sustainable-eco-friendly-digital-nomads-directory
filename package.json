{
  "name": "sustainable-eco-friendly-digital-nomads-directory-root",
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "app-next-directory",
    "sanity"
  ],
  "version": "0.1.3",
  "private": true,
  "description": "Root package for the Sustainable Eco-Friendly Digital Nomads Directory project",
  "scripts": {
    "test": "pnpm exec jest",
    "dev:next": "pnpm --filter app-next-directory dev",
    "dev:sanity": "pnpm --filter sanity dev",
    "dev": "pnpm dev:next",
    "build:next": "pnpm --filter app-next-directory build",
    "build:sanity": "pnpm --filter sanity build",
    "build": "pnpm build:next && pnpm build:sanity",
    "start:next": "pnpm --filter app-next-directory start",
    "start:sanity": "pnpm --filter sanity start",
    "start": "pnpm start:next",
    "lint:next": "pnpm --filter app-next-directory lint",
    "lint:sanity": "pnpm --filter sanity lint",
    "lint": "pnpm lint:next",
    "test:watch": "pnpm --filter app-next-directory test:watch",
    "test:coverage": "pnpm --filter app-next-directory test:coverage",
    "test:ci": "pnpm --filter app-next-directory test:ci",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@sanity/client": "^7.8.2",
    "@sanity/code-input": "^5.2.1",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "16.5.0",
    "react-countup": "^6.5.3",
    "react-hook-form": "^7.62.0",
    "resend": "^4.8.0",
    "vscode-variables": "^1.0.1"
  },
  "jest": "./app-next-directory/jest.config.js",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "eslint"
      ]
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "prisma",
      "@prisma/engines",
      "better-sqlite3",
      "sqlite3",
      "@parcel/watcher",
      "fsevents",
      "playwright",
      "@playwright/test",
      "node-gyp",
      "canvas",
      "node-sass",
      "@next/swc"
    ]
  },
  "@auth/mongodb-adapter": "^3.10.0",
  "@swc/jest": "^0.2.39",
  "@testing-library/dom": "^10.4.0",
  "@testing-library/react-hooks": "^8.0.1",
  "@types/jest": "^30.0.0",
  "@playwright/test": "^1.54.2",
  "cross-fetch": "^4.1.0",
  "eslint": "^9.29.0",
  "eslint-config-next": "^15.3.4",
  "jest-mock-extended": "^4.0.0",
  "ts-jest": "^29.4.0",
  "whatwg-fetch": "^3.6.20",
  "node-fetch": "^3.3.2",
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
